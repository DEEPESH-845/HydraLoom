# Copy to .env.local. Both are optional.

# Frontend: where the evaluation backend answers, as the BROWSER reaches it. https in production.
# Without it the app expects http://localhost:8000 and runs on the simulated roster when nothing answers.
NEXT_PUBLIC_GANTRYLAB_API=http://localhost:8000

# Backend (set where the backend runs, never in the frontend):
# GANTRYLAB_API_TOKEN=            required for uploads, runs and reports when set. Set it on anything not on localhost.
# GANTRYLAB_CORS_ORIGINS=https://your-app.example        the frontend's origin(s), comma separated
# GANTRYLAB_DATA_DIR=/data
