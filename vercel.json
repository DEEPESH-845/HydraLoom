{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!backend' ':!docs' ':!e2e' ':!*.md' ':!docker-compose.yml' ':!playwright.config.ts' ':!.github'",
  "regions": ["bom1"]
}
