{
  "name": "hydraloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sim:check": "tsx lib/sim/selfcheck.ts",
    "test:unit": "tsx --test \"lib/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "backend": "bash scripts/backend.sh",
    "rl:train": "tsx scripts/rl-train.ts",
    "backend:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run sim:check && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
